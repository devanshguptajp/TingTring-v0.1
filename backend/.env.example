NODE_ENV=development
PORT=3000
WEB_ORIGIN=http://localhost:8080

# Supabase project settings. Never commit real keys.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# One-time bootstrap: exact verified email of the first Owner account
INITIAL_OWNER_EMAIL=

# Optional JSON string for Firebase Admin SDK (store as a secret in hosting)
FIREBASE_SERVICE_ACCOUNT_JSON=
